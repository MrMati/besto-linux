#!/bin/sh
# Half of RAM as a zstd-compressed zram device. On this board that is 128MB of
# swap that typically holds 350-400MB of pages, which is the difference between
# "apt upgrade completes" and "the OOM killer picks a winner".
set -eu

DEV=/dev/zram0
SIZE_PCT=${ZRAM_SIZE_PCT:-50}
ALGO=${ZRAM_ALGO:-zstd}

case "${1:-start}" in
start)
	[ -e "$DEV" ] || { modprobe zram num_devices=1; sleep 0.2; }
	# Already configured (e.g. re-run): nothing to do.
	grep -q "^$DEV " /proc/swaps && exit 0

	total_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
	size_kb=$((total_kb * SIZE_PCT / 100))

	echo "$ALGO" > /sys/block/zram0/comp_algorithm 2>/dev/null || true
	echo "${size_kb}K" > /sys/block/zram0/disksize

	mkswap -L zram0 "$DEV" >/dev/null
	# Higher priority than any on-disk swap so zram is always used first.
	swapon -p 100 "$DEV"
	;;
stop)
	grep -q "^$DEV " /proc/swaps && swapoff "$DEV" || true
	[ -e /sys/block/zram0/reset ] && echo 1 > /sys/block/zram0/reset || true
	;;
*)
	echo "usage: $0 {start|stop}" >&2
	exit 1
	;;
esac
