#!/bin/sh
set -eu

done_marker=/var/lib/luckfox/growroot-done

root_src=$(findmnt -no SOURCE /)
case "$root_src" in
/dev/mmcblk*p*)
	disk=${root_src%p*}
	part=${root_src##*p}
	;;
*)
	# UBI, NFS, initramfs: nothing to grow, and nothing to retry either.
	echo "root is $root_src, not a partition: nothing to grow"
	mkdir -p "$(dirname "$done_marker")"
	touch "$done_marker"
	exit 0
	;;
esac

echo "growing $root_src (partition $part of $disk)"
if command -v growpart >/dev/null 2>&1; then
	# 0 resized, 1 error, 2 nothing to do (already fills the disk).
	growpart "$disk" "$part" || [ $? = 2 ]
else
	# sfdisk moves the end of the last partition in place. --no-tell-kernel
	# because the BLKRRPART it would otherwise issue cannot succeed on a
	# disk holding the mounted root -- it fails with EBUSY and prints "The
	# kernel still uses the old table", which is alarming and untrue by the
	# time partx has updated the one partition that changed.
	echo ", +" | sfdisk --no-reread --no-tell-kernel --force -N "$part" "$disk"
	partx -u "$disk"
fi

# Online resize: / is already mounted rw by the time this unit runs.
resize2fs "$root_src"

mkdir -p "$(dirname "$done_marker")"
touch "$done_marker"
