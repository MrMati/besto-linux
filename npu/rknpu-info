#!/bin/sh
# Report the state of the NPU: driver, clock, load and the runtime userspace
# will actually load.
set -eu

say() { printf '%-16s %s\n' "$1" "$2"; }

if [ ! -e /dev/rknpu ]; then
	echo "no /dev/rknpu -- the rknpu driver did not bind." >&2
	echo "check: dmesg | grep -i rknpu, and that the npu node is enabled in the DTB." >&2
	exit 1
fi

say "device" "/dev/rknpu ($(stat -c '%A %U:%G' /dev/rknpu))"

if [ -r /proc/rknpu/version ]; then
	say "driver" "$(cat /proc/rknpu/version)"
fi

clk=$(cat /proc/rknpu/freq 2>/dev/null || true)
[ -n "$clk" ] && say "npu clock" "$((clk / 1000000)) MHz"

if [ -r /proc/rknpu/load ]; then
	say "load" "$(cat /proc/rknpu/load)"
fi

lib=$(ls /usr/lib/*/librknnmrt.so.2 2>/dev/null | head -1 || true)
if [ -n "$lib" ]; then
	say "runtime" "$lib"
else
	say "runtime" "not installed"
fi

t=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || true)
[ -n "$t" ] && say "soc temp" "$((t / 1000)) C"

f=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null || true)
[ -n "$f" ] && say "cpu clock" "$((f / 1000)) MHz ($(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null))"
