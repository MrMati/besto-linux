kernel_addr_r=0x00800000
fdt_addr_r=0x04000000
ramdisk_addr_r=0x04400000
scriptaddr=0x04500000
pxefile_addr_r=0x04600000
fdtfile=rv1106g3-luckfox-pico-max.dtb

/*
 * Standard boot handles the microSD card: it finds the boot partition and
 * reads /extlinux/extlinux.conf from it. If there is no card, or the card has
 * no bootflow, fall back to the UBI rootfs in the SPI NAND.
 */
ubi_bootargs=console=ttyS2,115200n8 ubi.mtd=ubi root=ubi0:rootfs rootfstype=ubifs rw rootwait cma=64M
bootubi=ubi part ubi && ubifsmount ubi0:rootfs && ubifsload ${kernel_addr_r} /boot/zImage && ubifsload ${fdt_addr_r} /boot/${fdtfile} && setenv bootargs ${ubi_bootargs} && bootz ${kernel_addr_r} - ${fdt_addr_r}
bootcmd=bootflow scan -lb; run bootubi
