kernel_addr_r=0x00800000
fdt_addr_r=0x04000000
scriptaddr=0x04500000
pxefile_addr_r=0x04600000
ramdisk_addr_r=0x04400000
fdtfile=rv1106g3-luckfox-pico-max.dtb

/*
 * Standard boot handles the microSD card: it finds the boot partition and
 * reads /extlinux/extlinux.conf from it. If there is no card, or the card has
 * no bootflow, fall back to the UBI rootfs in the SPI NAND.
 *
 * This root stays rw: UBIFS has no fsck to run, so the read-only handover the
 * SD card gets from extlinux.conf would buy nothing here.
 */
ubi_bootargs=console=ttyS2,115200n8 ubi.mtd=ubi root=ubi0:rootfs rootfstype=ubifs rw rootwait
bootubi=ubi part ubi && ubifsmount ubi0:rootfs && ubifsload ${kernel_addr_r} /boot/zImage && ubifsload ${fdt_addr_r} /boot/${fdtfile} && setenv bootargs ${ubi_bootargs} && bootz ${kernel_addr_r} - ${fdt_addr_r}
bootcmd=bootflow scan -lb; run bootubi

/*
 * `run maskrom` puts the board back in the BootROM's USB download mode
 * (2207:110c) without the BOOT button, which is the difference between one
 * command and a power cycle on every flash. It is what
 * set_back_to_bootrom_dnl_flag() does: the magic lands in an OS_REG that the
 * warm reset does not clear, and the BootROM reads it before it looks at any
 * flash device. If the BootROM ignores it, U-Boot just comes back up.
 */
maskrom=mw.l CONFIG_ROCKCHIP_BOOT_MODE_REG 0xef08a53c; reset
