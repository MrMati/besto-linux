/*
 * Luckfox Pico Max -- RV1106G3, 256MB DDR3L, 256MB SPI NAND.
 *
 * Deliberately lean: this describes the board as a general purpose Linux
 * machine, not as an IP camera. The camera/ISP/encoder half of the SoC is left
 * disabled, which is what rv1106.dtsi already does -- we simply do not include
 * rv1106-evb.dtsi or rv1106-ipc.dtsi, both of which turn it all on and pull in
 * a fixed set of sensors.
 *
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rv1106.dtsi"

/ {
	model = "Luckfox Pico Max";
	compatible = "luckfox,pico-max", "rockchip,rv1106g3", "rockchip,rv1106";

	chosen {
		/*
         * sane default for the case
		 * where the DTB is booted by hand.
		 */
		bootargs = "console=ttyS2,115200n8 rootwait";
	};

	vcc_1v8: regulator-vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * VDD_ARM. Rockchip's reference design puts a PWM-controlled buck here
	 * so that DVFS can drop the rail with the frequency and raise it for
	 * the top bins; Luckfox left the buck off the Pico Max and fitted a
	 * fixed 0.9 V supply instead.
	 *
	 * cpufreq still needs a regulator behind cpu-supply -- rockchip-cpufreq
	 * refuses to probe without one -- so describe the rail as what it is.
	 * A regulator-fixed must have min == max in 6.6, otherwise
	 * of_get_fixed_voltage_config() rejects it as "specified with variable
	 * voltages"; Luckfox's own 800000..1000000 node would not probe here.
	 *
	 * The consequence is in &cpu0_opp_table: every OPP above 1.2 GHz wants
	 * more than 0.9 V and there is nothing to raise it with.
	 */
	vdd_arm: regulator-vdd-arm {
		compatible = "regulator-fixed";
		regulator-name = "vdd_arm";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		regulator-always-on;
		regulator-boot-on;
	};

	leds {
		compatible = "gpio-leds";

		work_led: led-0 {
			gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			default-state = "on";
			function = "activity";
		};
	};

};

/* ------------------------------------------------------------------ CPU --- */

&cpu0 {
	cpu-supply = <&vdd_arm>;
	/* cpufreq-dt registers the cpufreq cooling device off this. */
	#cooling-cells = <2>;
};

/*
 * rv1106.dtsi carries the SoC's full OPP table, up to 1.608 GHz. Everything
 * from 1.296 GHz up asks for more than the 0.9 V this board's fixed rail
 * supplies, and the OPP core would happily use them anyway: the fallback leg
 * of regulator_set_voltage_triplet() asks for the OPP's u_volt_min (850 mV for
 * every entry in this table), which a fixed 0.9 V rail satisfies. So the only
 * thing keeping the CPU inside its voltage/frequency envelope is the table
 * itself. Stop at 1.2 GHz, the fastest OPP that runs at 850 mV.
 *
 * The pvtpll properties go with them. PVTPLL calibration walks the rail up and
 * down in 12.5 mV steps while watching the ring oscillator, to find the
 * lowest voltage each >= 1.104 GHz OPP is stable at. With a rail that cannot
 * move there is nothing to search, and rockchip_pvtpll_calibrate_opp() would
 * still take the CPU to 1.104 GHz and rewrite the table's voltages on the way
 * to giving up.
 */
&cpu0_opp_table {
	/delete-property/ rockchip,pvtpll-avg-offset;
	/delete-property/ rockchip,pvtpll-min-rate;
	/delete-property/ rockchip,pvtpll-volt-step;

	/delete-node/ opp-1296000000;
	/delete-node/ opp-1416000000;
	/delete-node/ opp-1512000000;
	/delete-node/ opp-1608000000;
};

/* ---------------------------------------------------------------- flash --- */

&sfc {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 { label = "env"; reg = <0x00000000 0x00040000>; };
			partition@40000 { label = "idblock"; reg = <0x00040000 0x00100000>; read-only; };
			partition@140000 { label = "uboot"; reg = <0x00140000 0x00100000>; read-only; };
			partition@240000 { label = "boot"; reg = <0x00240000 0x01000000>; };
			partition@1240000 { label = "ubi"; reg = <0x01240000 0x0edc0000>; };
		};
	};
};

&sdmmc {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	no-mmc;
	no-sdio;
	max-frequency = <50000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	status = "okay";
};

/* ------------------------------------------------------------- ethernet --- */

/*
 * 100M, integrated PHY.
 *
 * There is no MAC address anywhere on this board to read. dwmac-rk keeps one
 * in Rockchip vendor storage, a reserved area at the end of the boot medium
 * that the factory programs; nothing ever programmed this one, and an SD card
 * written by mk-image.sh has no such area at all. The driver's answer to that
 * was eth_random_addr(), so the board took a new MAC -- and a new DHCP lease
 * -- on every boot.
 *
 * Name the OTP's 16-byte unique id, the same cell rockchip-cpuinfo hashes into
 * /proc/cpuinfo's Serial, and the patched driver derives a locally administered
 * address from it: stable for the life of the chip, distinct between chips.
 * kernel/patches/0003 has the details.
 */
&gmac {
	nvmem-cells = <&otp_id>;
	nvmem-cell-names = "soc-id";
	status = "okay";
};

/* ------------------------------------------------------------------ USB --- */

&u2phy {
	status = "okay";
};

&u2phy_otg {
	rockchip,dis-u2-susphy;
	status = "okay";
};

&usbdrd {
	status = "okay";
};

/*
 * The Type-C port is the board's only USB port and its power inlet, and the
 * connector has no ID pin -- there is no CC controller behind it either, just
 * a socket wired to the SoC's one USB 2.0 OTG controller.
 *
 * dr_mode = "otg" therefore does not mean what it looks like it means. With no
 * extcon to consult, dwc3 falls back to the OTG block's CONIDSTS bit, which
 * follows the PHY's iddig input, which nothing on this board drives; it reads
 * as grounded, dwc3 concludes it is the A-device and brings up xHCI. The port
 * then has no VBUS to offer a downstream device and no UDC for a gadget to
 * bind to, so it does nothing in either direction -- and usb_add_hcd() offers
 * the PHY PHY_MODE_USB_HOST_SS on the way past, which
 * rockchip_usb2phy_set_mode() does not handle, hence "illegal mode" in dmesg.
 *
 * Peripheral is what the hardware is, and is what Luckfox's own devicetree
 * says. It gives the gadget in luckfox-usb-gadget.service a UDC to bind to.
 * Set this to "host" instead if you power the board through the pin header and
 * want to plug devices into the Type-C.
 */
&usbdrd_dwc3 {
	dr_mode = "peripheral";
	status = "okay";
};

/* --------------------------------------------------------------- sensors --- */

&saradc {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

&tsadc {
	status = "okay";
};

/*
 * rv1106.dtsi describes the trip points but binds no cooling device to them,
 * so the passive trips did nothing and the only thermal response the SoC had
 * was the critical trip at 115 C. Hand the CPU to the step_wise governor at
 * the 85 C trip; it is the one cooling device this board has.
 */
&soc_thermal {
	cooling-maps {
		map0 {
			trip = <&target>;
			cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			contribution = <1024>;
		};
	};
};

/* -------------------------------------------------------------- entropy --- */

&rng {
	status = "okay";
};

/* -------------------------------------------------------------- console --- */

&uart2 {
	status = "okay";
};

&wdt {
	status = "okay";
};

&rtc {
	status = "okay";
};
