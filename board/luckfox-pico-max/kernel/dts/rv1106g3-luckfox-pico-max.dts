/*
 * Luckfox Pico Max -- RV1106G3, 256MB DDR3L, 256MB SPI NAND.
 *
 * Deliberately lean: this describes the board as a general purpose Linux
 * machine with an NPU, not as an IP camera. The camera/ISP/encoder half of the
 * SoC is left disabled, which is what rv1106.dtsi already does -- we simply do
 * not include rv1106-evb.dtsi or rv1106-ipc.dtsi, both of which turn it all on
 * and pull in a fixed set of sensors.
 *
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rv1106.dtsi"

/ {
	model = "Luckfox Pico Max";
	compatible = "luckfox,pico-max", "rockchip,rv1106g3", "rockchip,rv1106";

	chosen {
		/*
         * sane default for the case
		 * where the DTB is booted by hand.
		 */
		bootargs = "console=ttyS2,115200n8 rootwait";
	};

	vcc_1v8: regulator-vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * VDD_ARM. Rockchip's reference design puts a PWM-controlled buck here
	 * so that DVFS can drop the rail with the frequency and raise it for
	 * the top bins; Luckfox left the buck off the Pico Max and fitted a
	 * fixed 0.9 V supply instead.
	 *
	 * cpufreq still needs a regulator behind cpu-supply -- rockchip-cpufreq
	 * refuses to probe without one -- so describe the rail as what it is.
	 * A regulator-fixed must have min == max in 6.6, otherwise
	 * of_get_fixed_voltage_config() rejects it as "specified with variable
	 * voltages"; Luckfox's own 800000..1000000 node would not probe here.
	 *
	 * The consequence is in &cpu0_opp_table: every OPP above 1.2 GHz wants
	 * more than 0.9 V and there is nothing to raise it with.
	 */
	vdd_arm: regulator-vdd-arm {
		compatible = "regulator-fixed";
		regulator-name = "vdd_arm";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		regulator-always-on;
		regulator-boot-on;
	};

	leds {
		compatible = "gpio-leds";

		work_led: led-0 {
			gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			default-state = "on";
			function = "activity";
		};
	};
};

/* ------------------------------------------------------------------ CPU --- */

&cpu0 {
	cpu-supply = <&vdd_arm>;
	/* cpufreq-dt registers the cpufreq cooling device off this. */
	#cooling-cells = <2>;
};

/*
 * rv1106.dtsi carries the SoC's full OPP table, up to 1.608 GHz. Everything
 * from 1.296 GHz up asks for more than the 0.9 V this board's fixed rail
 * supplies, and the OPP core would happily use them anyway: the fallback leg
 * of regulator_set_voltage_triplet() asks for the OPP's u_volt_min (850 mV for
 * every entry in this table), which a fixed 0.9 V rail satisfies. So the only
 * thing keeping the CPU inside its voltage/frequency envelope is the table
 * itself. Stop at 1.2 GHz, the fastest OPP that runs at 850 mV.
 *
 * The pvtpll properties go with them. PVTPLL calibration walks the rail up and
 * down in 12.5 mV steps while watching the ring oscillator, to find the
 * lowest voltage each >= 1.104 GHz OPP is stable at. With a rail that cannot
 * move there is nothing to search, and rockchip_pvtpll_calibrate_opp() would
 * still take the CPU to 1.104 GHz and rewrite the table's voltages on the way
 * to giving up.
 */
&cpu0_opp_table {
	/delete-property/ rockchip,pvtpll-avg-offset;
	/delete-property/ rockchip,pvtpll-min-rate;
	/delete-property/ rockchip,pvtpll-volt-step;

	/delete-node/ opp-1296000000;
	/delete-node/ opp-1416000000;
	/delete-node/ opp-1512000000;
	/delete-node/ opp-1608000000;
};

/* ------------------------------------------------------------------ NPU --- */

&npu {
	assigned-clocks = <&cru ACLK_RKNN>;
	assigned-clock-rates = <500000000>;

	interrupt-names = "npu_irq";
	status = "okay";
};

/*
 * Overclock the NPU to 594 MHz. Comment this line out for the 500 MHz the
 * clock tree comes up on; it has to sit after &npu, because a later override
 * wins. The dtsi explains what actually carries the rate.
 */
#include "rv1106g3-luckfox-pico-max-npu-594mhz.dtsi"

/* ---------------------------------------------------------------- flash --- */

&sfc {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

&sdmmc {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	no-mmc;
	no-sdio;
	max-frequency = <50000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	status = "okay";
};

/* ------------------------------------------------------------- ethernet --- */

/* 100M, integrated PHY. MAC address comes from the OTP via nvmem. */
&gmac {
	status = "okay";
};

/* ------------------------------------------------------------------ USB --- */

&u2phy {
	status = "okay";
};

&u2phy_otg {
	rockchip,dis-u2-susphy;
	status = "okay";
};

&usbdrd {
	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "otg";
	status = "okay";
};

/* --------------------------------------------------------------- sensors --- */

&saradc {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

&tsadc {
	status = "okay";
};

/*
 * rv1106.dtsi describes the trip points but binds no cooling device to them,
 * so the passive trips did nothing and the only thermal response the SoC had
 * was the critical trip at 115 C. Hand the CPU to the step_wise governor at
 * the 85 C trip; it is the one cooling device this board has.
 */
&soc_thermal {
	cooling-maps {
		map0 {
			trip = <&target>;
			cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			contribution = <1024>;
		};
	};
};

/* -------------------------------------------------------------- entropy --- */

&rng {
	status = "okay";
};

/* -------------------------------------------------------------- console --- */

&uart2 {
	status = "okay";
};

&wdt {
	status = "okay";
};

&rtc {
	status = "okay";
};
