# Turn Rockchip's rv1106_defconfig -- an IP-camera configuration -- into a
# kernel that a general purpose glibc userspace can actually boot on.
#
# Merged on top of rv1106_defconfig with scripts/kconfig/merge_config.sh, so
# every symbol here wins over the base. Anything already correct in the base
# (RKNPU, CMA, the Rockchip clock/pinctrl/thermal drivers) is not repeated.

# --------------------------------------------------------------- console ---
# Rockchip routes UART2 through their out-of-tree FIQ debugger and calls it
# ttyFIQ0. It is a nice debugging aid and a constant source of confusion for
# every piece of standard userspace that expects a real tty. Use plain 8250.
# CONFIG_FIQ_DEBUGGER is not set
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# ------------------------------------------------------------ command line ---
# The bootloader owns the command line; do not append a built-in one. An empty
# CMDLINE makes arch/arm/Kconfig hide the FROM_BOOTLOADER/EXTEND/FORCE choice
# entirely and the bootloader's line is used unconditionally, so asking for
# FROM_BOOTLOADER by name would be asking for a symbol kconfig cannot set.
CONFIG_CMDLINE=""

# ------------------------------------------------------- systemd essentials ---
# Everything systemd's README lists as required or strongly recommended.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
# No CPUSETS: it depends on SMP and the RV1106 is single-core.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FHANDLE=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_BPF_SYSCALL=y
CONFIG_FILE_LOCKING=y
CONFIG_AUTOFS_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_NETLINK_DIAG=y
CONFIG_PACKET_DIAG=y

# ------------------------------------------------------------------ memory ---
# 256MB with a full glibc userspace really wants compressed swap. zram with
# zstd typically gives ~3x, which is the difference between "apt upgrade works"
# and "the OOM killer works".
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y
# ZRAM_BACKEND_ZSTD only exists from 6.11, and MEMCG_SWAP was folded into
# MEMCG in 6.1. On this 6.6 tree both would just be noise.

# --------------------------------------------------------------- filesystems ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
# rv1106_defconfig carries squashfs for Rockchip's recovery partition. This
# tree boots ext4 from SD or UBIFS from NAND and never builds a squashfs, and
# dropping it takes the XZ decompressor with it.
# CONFIG_SQUASHFS is not set

# UBI/UBIFS for the on-board SPI NAND.
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NAND=y
CONFIG_SPI_ROCKCHIP_SFC=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_BLOCK=y
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_ADVANCED_COMPR=y
CONFIG_UBIFS_FS_ZSTD=y
CONFIG_UBIFS_FS_XATTR=y
CONFIG_UBIFS_FS_SECURITY=y

# ------------------------------------------------------------------ storage ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# ------------------------------------------------------------------ network ---
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_ROCKCHIP_PHY=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NF_NAT=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_BRIDGE=m
CONFIG_NET_CORE=y
CONFIG_VETH=m
CONFIG_TUN=m

# ---------------------------------------------------------------------- USB ---
# USB_SUPPORT is the `menuconfig` wrapping all of drivers/usb/Kconfig, and
# rv1106_defconfig clears it, which makes every symbol below invisible.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
# usb-storage is a SCSI upper-layer driver.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
# The inno USB2 phy `depends on EXTCON` for its OTG id/vbus handling.
CONFIG_EXTCON=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_ETH=m

# ------------------------------------------------------------- buses and IO ---
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_RK3X=y
CONFIG_SPI=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_SPI_SPIDEV=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_PWM=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
# rtc-rockchip.c is what matches the DTS's "rockchip,rv1106-rtc".
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_ROCKCHIP=y
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
CONFIG_IIO=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_HWMON=y

# -------------------------------------------------------------- power/thermal ---
# schedutil would be the obvious governor but it `depends on SMP`, and the
# RV1106 is single-core. ondemand is the best available default; leaving the
# default unset lands on PERFORMANCE, i.e. pinned at 1.2 GHz for ever.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_ROCKCHIP_CPUFREQ=y
# The one that matters. rockchip-cpufreq calls rockchip_init_opp_info() before
# it will register the cpufreq-dt device, and without ROCKCHIP_OPP that is the
# stub in <soc/rockchip/rockchip_opp_select.h> returning -EOPNOTSUPP. The
# driver then reports "failed to init opp info"/-95 and bails, which is why
# there was no /sys/devices/system/cpu/cpu0/cpufreq at all. Nothing selects it
# and rv1106_defconfig does not set it, although Luckfox's own 5.10 defconfig
# does.
CONFIG_ROCKCHIP_OPP=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y

# ------------------------------------------------------------------- RKNPU ---
# Built in rather than a module: nothing else needs to be loaded before it, and
# an always-present /dev/rknpu means the runtime just works after boot.
#
# The memory manager is the Rockchip CMA dma-heap, not DRM GEM -- the RV1106
# has no IOMMU and no DRM stack, and librknnmrt expects the heap path.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_ROCKCHIP=y
CONFIG_DMABUF_HEAPS_ROCKCHIP_CMA_HEAP=y
CONFIG_SYNC_FILE=y
CONFIG_ROCKCHIP_RKNPU=y
CONFIG_ROCKCHIP_RKNPU_DMA_HEAP=y
CONFIG_ROCKCHIP_RKNPU_FENCE=y
CONFIG_ROCKCHIP_RKNPU_PROC_FS=y
# procfs and debugfs expose the same seven nodes (version, load, power, freq,
# volt, delayms, reset) off one list in rknpu_debugger.c, so this is not the
# reason to want debugfs -- see DEBUG_FS under observability for that. It is
# free once debugfs is on, and `default y` in drivers/rknpu/Kconfig.
CONFIG_ROCKCHIP_RKNPU_DEBUG_FS=y

# ----------------------------------------------------------------- modules ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=y

# ------------------------------------------------------------ observability ---
# No PROC_KCORE: its prompt is `bool "..." if !ARM`, so ARM cannot set it.
#
# rv1106_defconfig leaves debugfs off, which costs more than the RKNPU nodes:
# the clock framework only publishes rates under /sys/kernel/debug/clk, and
# that is where npu/rknpu-info reads aclk_rknn from to say whether the NPU
# really came up at 500 MHz. There is no procfs equivalent to fall back to.
CONFIG_DEBUG_FS=y
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PRINTK_TIME=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_ROCKCHIP=y
