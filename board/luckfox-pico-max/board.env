# Luckfox Pico Max -- Rockchip RV1106G3
#
# Cortex-A7 @ up to 1.2 GHz, 256 MB in-package DDR3L, 256 MB SPI NAND,
# 0.5 TOPS (int8) RKNPU, 100M Ethernet with an integrated PHY, USB 2.0 OTG.
#
# Sourced by scripts/lib.sh. Everything here can be overridden from the
# environment, e.g.  ROOTFS_SUITE=bookworm make rootfs

BOARD_NAME="luckfox-pico-max"
BOARD_DESC="Luckfox Pico Max (RV1106G3)"

# ---------------------------------------------------------------- silicon ---
SOC="rv1106"
DRAM_SIZE_MB="256"
# rkbin DDR init blob. The 924 MHz timing set is the one Luckfox ships and is
# the only one validated against the Pico Max's in-package DDR3L.
RKBIN_DDR_BIN="bin/rv11/rv1106_ddr_924MHz_v1.15.bin"

# ------------------------------------------------------------------ u-boot ---
UBOOT_DEFCONFIG="luckfox-pico-max-rv1106_defconfig"
UBOOT_DTB="rv1106-luckfox-pico-max"

# ------------------------------------------------------------------ kernel ---
KERNEL_DEFCONFIG="rv1106_defconfig"
KERNEL_DTS="rv1106g3-luckfox-pico-max"
KERNEL_IMAGE="zImage"

# CMA is where the NPU allocates weights and feature maps. 64 MB comfortably
# holds the RKNN runtime's working set for the models this SoC can run; drop it
# to 32 MB if you need the RAM back and only run small models.
CMA_SIZE="64M"

# ------------------------------------------------------------------ rootfs ---
ROOTFS_SUITE="${ROOTFS_SUITE:-trixie}"
ROOTFS_MIRROR="${ROOTFS_MIRROR:-http://deb.debian.org/debian}"
ROOTFS_ARCH="armhf"
ROOTFS_PROFILE="${ROOTFS_PROFILE:-standard}"   # minimal | standard | dev
ROOTFS_HOSTNAME="${ROOTFS_HOSTNAME:-luckfox}"
# Set to an empty string to lock the root account and rely on SSH keys only.
ROOTFS_ROOT_PASSWORD="${ROOTFS_ROOT_PASSWORD:-luckfox}"

# ------------------------------------------------------------------- flash ---
# SPI NAND geometry (Winbond W25N02KV / equivalent, 256 MB).
NAND_SIZE="0x10000000"
NAND_PAGE_SIZE="2048"
NAND_BLOCK_SIZE="131072"       # 128 KiB
NAND_LEB_SIZE="126976"         # 124 KiB usable per LEB
NAND_SUBPAGE_SIZE="2048"

# SPI NAND partition map. Must stay in sync with the "partitions" node in
# board/luckfox-pico-max/uboot/tree/arch/arm/dts/rv1106-luckfox-pico-max.dts
# and with rootfs/overlay/etc/fw_env.config.
NAND_ENV_OFFSET="0x00000000"; NAND_ENV_SIZE="0x00040000"      # 256 KiB
NAND_IDB_OFFSET="0x00040000"; NAND_IDB_SIZE="0x00100000"      #   1 MiB
NAND_UBOOT_OFFSET="0x00140000"; NAND_UBOOT_SIZE="0x00100000"  #   1 MiB
NAND_BOOT_OFFSET="0x00240000"; NAND_BOOT_SIZE="0x01000000"    #  16 MiB
NAND_UBI_OFFSET="0x01240000"; NAND_UBI_SIZE="0x0edc0000"      # ~237 MiB

# SD card image. The BootROM reads the idblock from LBA 64 (32 KiB), so the
# first megabyte is reserved for the boot chain and the GPT starts after it.
SD_IDB_OFFSET_KIB="32"
SD_UBOOT_OFFSET_KIB="1024"
SD_BOOT_PART_MIB="64"
SD_ROOT_SLACK_MIB="256"        # free space added on top of the rootfs contents
