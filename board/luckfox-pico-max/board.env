# Luckfox Pico Max -- Rockchip RV1106G3
#
# Cortex-A7 @ up to 1.2 GHz, 256 MB in-package DDR3L, 256 MB SPI NAND,
# 1 TOPS (int8) RKNPU, 100M Ethernet with an integrated PHY, USB 2.0 OTG.
#
# Sourced by scripts/lib.sh. Everything here can be overridden from the
# environment, e.g.  ROOTFS_SUITE=bookworm make rootfs

BOARD_NAME="luckfox-pico-max"
BOARD_DESC="Luckfox Pico Max (RV1106G3)"

# ---------------------------------------------------------------- silicon ---
SOC="rv1106"
DRAM_SIZE_MB="256"
# rkbin DDR init blob. The 924 MHz timing set is the one Luckfox ships and is
# the only one validated against the Pico Max's in-package DDR3L.
RKBIN_DDR_BIN="bin/rv11/rv1106_ddr_924MHz_v1.15.bin"

# ------------------------------------------------------------------ u-boot ---
UBOOT_DEFCONFIG="luckfox-pico-max-rv1106_defconfig"
UBOOT_DTB="rv1106-luckfox-pico-max"

# ------------------------------------------------------------------ kernel ---
KERNEL_DEFCONFIG="rv1106_defconfig"
KERNEL_DTS="rv1106g3-luckfox-pico-max"
KERNEL_IMAGE="zImage"

# Where the NPU allocates weights and feature maps. 32 MB holds the RKNN
# runtime's working set for the models this SoC can run, and is what the board
# has in fact been running on all along; raise it if you hit an allocation
# failure from the runtime, and pay for it out of the number below.
#
# The knob is rk_dma_heap_cma=, not the generic cma=. With RKNPU_DMA_HEAP the
# runtime allocates from Rockchip's own heap, which reserves its own CMA area
# in rk_dma_heap_cma_setup() (drivers/dma-buf/rk_heaps/rk-dma-cma.c) and
# defaults to SZ_32M. cma= is worse than merely ignored here: rv1106_defconfig
# sets CMA_INACTIVE, which compiles out the alignment sanitising in
# cma_declare_contiguous_nid(), so dma_contiguous_reserve_area() arrives with
# alignment 0, ALIGN(size, 0) collapses the size to zero, and the boot log gets
# a memblock stack dump and "cma: Failed to reserve 0 KiB" for its trouble.
#
# CMA_INACTIVE also means the area is carved out for good rather than lent to
# the page allocator as movable, so every megabyte here is a megabyte userspace
# never sees: at 32 MB the board boots with ~220 MB of its 256 MB available,
# and each further 32 MB comes straight off that.
RK_DMA_HEAP_SIZE="32M"

# ------------------------------------------------------------------ rootfs ---
ROOTFS_SUITE="${ROOTFS_SUITE:-trixie}"
ROOTFS_MIRROR="${ROOTFS_MIRROR:-http://deb.debian.org/debian}"
ROOTFS_ARCH="armhf"
ROOTFS_PROFILE="${ROOTFS_PROFILE:-standard}"   # minimal | standard | dev
ROOTFS_HOSTNAME="${ROOTFS_HOSTNAME:-luckfox}"
# Set to an empty string to lock the root account and rely on SSH keys only.
ROOTFS_ROOT_PASSWORD="${ROOTFS_ROOT_PASSWORD:-luckfox}"
# mmdebstrap knobs. These three, the suite, the arch, the mirror and the
# package list are the cache key for the base rootfs tarball in $DL, so
# changing any of them rebuilds it from scratch.
ROOTFS_VARIANT="${ROOTFS_VARIANT:-important}"
ROOTFS_COMPONENTS="${ROOTFS_COMPONENTS:-main,contrib,non-free-firmware}"
# The package list is not enough to pin what the packages resolve to, so the
# cached base expires on its own to pick up security updates.
ROOTFS_BASE_MAX_AGE_DAYS="${ROOTFS_BASE_MAX_AGE_DAYS:-7}"

# ------------------------------------------------------------------- flash ---
# SPI NAND geometry (Winbond W25N02KV / equivalent, 256 MB).
NAND_SIZE="0x10000000"
NAND_PAGE_SIZE="2048"
NAND_BLOCK_SIZE="131072"       # 128 KiB
NAND_LEB_SIZE="126976"         # 124 KiB usable per LEB
NAND_SUBPAGE_SIZE="2048"

# SPI NAND partition map. Must stay in sync with the "partitions" node in
# board/luckfox-pico-max/uboot/tree/arch/arm/dts/rv1106-luckfox-pico-max.dts
# and with rootfs/overlay/etc/fw_env.config.
NAND_ENV_OFFSET="0x00000000"; NAND_ENV_SIZE="0x00040000"      # 256 KiB
NAND_IDB_OFFSET="0x00040000"; NAND_IDB_SIZE="0x00100000"      #   1 MiB
NAND_UBOOT_OFFSET="0x00140000"; NAND_UBOOT_SIZE="0x00100000"  #   1 MiB
NAND_BOOT_OFFSET="0x00240000"; NAND_BOOT_SIZE="0x01000000"    #  16 MiB
NAND_UBI_OFFSET="0x01240000"; NAND_UBI_SIZE="0x0edc0000"      # ~237 MiB

# SD card image. The BootROM reads the idblock from LBA 64 (32 KiB), so the
# first megabyte is reserved for the boot chain and the GPT starts after it.
#
# SD_UBOOT_OFFSET_KIB is where the SPL goes looking for U-Boot proper, so it
# must match CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR in the defconfig (in
# 512-byte sectors: 1024 KiB = 0x800). Mainline's Rockchip default is 0x4000,
# i.e. 8 MiB, which is exactly where the root partition starts here; leaving it
# alone would have the SPL read the ext4 superblock and give up. check.sh keeps
# the two numbers honest.
SD_IDB_OFFSET_KIB="32"
SD_UBOOT_OFFSET_KIB="1024"
SD_ROOT_SLACK_MIB="256"        # free space added on top of the rootfs contents
