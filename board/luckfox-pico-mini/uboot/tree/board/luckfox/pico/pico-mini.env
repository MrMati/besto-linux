kernel_addr_r=0x00800000
fdt_addr_r=0x02000000
ramdisk_addr_r=0x03000000
scriptaddr=0x03400000
pxefile_addr_r=0x03500000
fdtfile=rv1103g-luckfox-pico-mini.dtb

/* SD extlinux is the development path; NAND UBIFS is the release path. */
ubi_bootargs=console=ttyS2,115200n8 ubi.mtd=ubi root=ubi0:rootfs rootfstype=ubifs rw rootwait
bootubi=ubi part ubi && ubifsmount ubi0:rootfs && ubifsload ${kernel_addr_r} /boot/zImage && ubifsload ${fdt_addr_r} /boot/${fdtfile} && setenv bootargs ${ubi_bootargs} && bootz ${kernel_addr_r} - ${fdt_addr_r}
bootcmd=bootflow scan -lb; run bootubi
maskrom=mw.l CONFIG_ROCKCHIP_BOOT_MODE_REG 0xef08a53c; reset
