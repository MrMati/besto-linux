# Luckfox Pico Mini -- Rockchip RV1103, 64MB DDR3L, 128MB W25N01KVZEIR NAND.
# (Sold as the Pico Mini B; the A variant is SD-only and has no SPI NAND.)
#
# The development artifact boots from a microSD root filesystem. The release
# artifact boots completely from NAND; a FAT32 card labelled LUCKFOX-DATA is
# mounted at /mnt/sdcard by the installed system.

BOARD_NAME="luckfox-pico-mini"
BOARD_DESC="Luckfox Pico Mini (RV1103, W25N01KVZEIR)"

SOC="rv1103"
DRAM_SIZE_MB="64"
RKBIN_DDR_BIN="bin/rv11/rv1106_ddr_924MHz_v1.15.bin"
# This loader has the W25N01xx-aware USB plug binary.
RKBIN_LOADER_INI="RKBOOT/RV1106MINIALL_SPI_NAND_W25N01XX_TB.ini"

UBOOT_DEFCONFIG="luckfox-pico-mini-rv1103_defconfig"
UBOOT_DTB="rv1103-luckfox-pico-mini"

KERNEL_DEFCONFIG="rv1106_defconfig"
KERNEL_DTS="rv1103g-luckfox-pico-mini"
KERNEL_IMAGE="zImage"
# The distro configuration is SoC-family generic and deliberately excludes the
# secure-world boot stage and accelerator driver for every supported board.
KERNEL_CONFIG_DIR="$TOP/board/luckfox-pico-max/kernel/config"

ROOTFS_SUITE="${ROOTFS_SUITE:-trixie}"
ROOTFS_MIRROR="${ROOTFS_MIRROR:-http://deb.debian.org/debian}"
ROOTFS_ARCH="armhf"
# 64MB RAM and 128MB NAND: minimal is the sensible Mini default.
ROOTFS_PROFILE="${ROOTFS_PROFILE:-minimal}"
ROOTFS_HOSTNAME="${ROOTFS_HOSTNAME:-luckfox}"
ROOTFS_ROOT_PASSWORD="${ROOTFS_ROOT_PASSWORD:-luckfox}"
ROOTFS_VARIANT="${ROOTFS_VARIANT:-important}"
ROOTFS_COMPONENTS="${ROOTFS_COMPONENTS:-main,contrib,non-free-firmware}"
ROOTFS_BASE_MAX_AGE_DAYS="${ROOTFS_BASE_MAX_AGE_DAYS:-7}"

NAND_SIZE="0x08000000"
NAND_PAGE_SIZE="2048"
NAND_BLOCK_SIZE="131072"
NAND_LEB_SIZE="126976"
NAND_SUBPAGE_SIZE="2048"

# Matches Luckfox's Mini W25N01KV layout and both U-Boot and kernel DTS files.
NAND_ENV_OFFSET="0x00000000"; NAND_ENV_SIZE="0x00040000"
NAND_IDB_OFFSET="0x00040000"; NAND_IDB_SIZE="0x00100000"
NAND_UBOOT_OFFSET="0x00140000"; NAND_UBOOT_SIZE="0x00100000"
NAND_BOOT_OFFSET="0x00240000"; NAND_BOOT_SIZE="0x00800000"
NAND_UBI_OFFSET="0x00a40000"; NAND_UBI_SIZE="0x075c0000"

SD_IDB_OFFSET_KIB="32"
SD_UBOOT_OFFSET_KIB="1024"
SD_ROOT_SLACK_MIB="128"
